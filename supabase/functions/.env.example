# Choose the WhatsApp backend used by the Edge Functions.
# Supported values: openwa | evolution
WHATSAPP_PROVIDER=openwa

# OpenWA Easy API (self-hosted)
OPENWA_API_URL=https://your-openwa-host.example.com
OPENWA_API_KEY=replace-with-a-strong-api-key

# Evolution fallback (optional when WHATSAPP_PROVIDER=openwa)
EVOLUTION_API_URL=https://your-evolution-host.example.com
EVOLUTION_INSTANCE_TOKEN=replace-with-your-instance-token

# Used by scheduled Edge Functions
CRON_SECRET=replace-with-a-random-secret
